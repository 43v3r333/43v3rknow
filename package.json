{
  "name": "codebase",
  "version": "1.0.0",
  "description": "Vibe coding companion - codebase intelligence dashboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "node server/index.js",
    "build": "cd client && npm run build",
    "start": "npm run server"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}